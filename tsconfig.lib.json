{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./lib",
    "emitDeclarationOnly": true,
    "outDir": "./lib",
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "samples/**/*"
  ]
}
