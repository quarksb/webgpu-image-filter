{
  "name": "webgpu-image-filter",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "main": "lib/webgpu-image-filter.js",
  "module": "lib/webgpu-image-filter.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/webgpu-image-filter.js",
      "types": "./lib/index.d.ts"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "vite build --mode demo",
